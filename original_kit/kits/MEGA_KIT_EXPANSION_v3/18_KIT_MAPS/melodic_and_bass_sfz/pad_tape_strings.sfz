<region> sample=../../14_MELODIC/pads/pad_tape_strings/pad_tape_strings_Fs3.wav pitch_keycenter=54 lokey=50 hikey=58 lovel=1 hivel=127
<region> sample=../../14_MELODIC/pads/pad_tape_strings/pad_tape_strings_Ds4.wav pitch_keycenter=63 lokey=59 hikey=67 lovel=1 hivel=127
<region> sample=../../14_MELODIC/pads/pad_tape_strings/pad_tape_strings_C5.wav pitch_keycenter=72 lokey=68 hikey=108 lovel=1 hivel=127
