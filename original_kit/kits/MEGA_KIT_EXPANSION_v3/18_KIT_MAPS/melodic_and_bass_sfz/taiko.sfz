<region> sample=../../20_TONAL_PERC/orchestral_taiko/taiko_F1.wav pitch_keycenter=29 lokey=28 hikey=30 lovel=1 hivel=127
<region> sample=../../20_TONAL_PERC/orchestral_taiko/taiko_G1.wav pitch_keycenter=31 lokey=31 hikey=32 lovel=1 hivel=127
<region> sample=../../20_TONAL_PERC/orchestral_taiko/taiko_A1.wav pitch_keycenter=33 lokey=33 hikey=34 lovel=1 hivel=127
<region> sample=../../20_TONAL_PERC/orchestral_taiko/taiko_C2.wav pitch_keycenter=36 lokey=35 hikey=108 lovel=1 hivel=127
