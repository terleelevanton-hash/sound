// MEGA KIT v3 - taiko (6 multi-sampled root zones)
// Full keyboard range A0..C8 (MIDI 21..108), non-overlapping zones, verified paths
<global>
ampeg_release=0.35
amp_veltrack=82

<region> sample=../../20_TONAL_PERC/orchestral_taiko/taiko_C1.wav pitch_keycenter=24 lokey=21 hikey=25 lovel=1 hivel=127
